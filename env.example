# LINE Developers コンソール > Messaging API設定 から取得
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# Google サービスアカウントの鍵JSON(ファイル全体)をBase64エンコードした文字列
# 作成手順: cat service-account-key.json | base64 -w 0
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=your_base64_encoded_json_key

# スタッフ一覧。"id:表示名:カレンダーID:LINEユーザーID" をカンマ区切りで複数指定する
# id は英数字のみ(LINEのボタンの内部データ・シフト設定ファイルの参照に使うため)
# staffIdは src/shiftSchedule.js のシフト定義と一致させること
# LINEユーザーIDは省略可(空にすると、そのスタッフへの予約通知は行われない)
# 例: STAFF_LIST=narita:成田:narita.youichi@gmail.com:U1234...,tanaka:田中:tanaka@example.com:
STAFF_LIST=narita:成田:your_calendar_id_narita@gmail.com:,furuya:古屋:your_calendar_id_furuya@gmail.com:,ando:安藤:your_calendar_id_ando@gmail.com:

# 1回の予約の長さ(分)
BOOKING_DURATION_MINUTES=60

# 予約開始時刻の候補の間隔(分)。省略時はBOOKING_DURATION_MINUTESと同じ
# BOOKING_INTERVAL_MINUTES=30

# 「終日勤務」のシフトの場合に使う時間帯(src/shiftSchedule.jsでstart/endをnullにした場合の代わりの時間)
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=18

# 何日先まで日付選択できるようにするか
MAX_DAYS_AHEAD=30

TIMEZONE=Asia/Tokyo

PORT=8080
