# LINE Developers > Messaging API settings
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# Base64-encoded Google service-account JSON key.
# macOS: base64 -i service-account-key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=your_base64_encoded_json_key

# Comma-separated staff entries:
# id:display_name:calendar_id:line_user_id(optional)
# IDs must match staffId values in src/shiftSchedule.js.
STAFF_LIST=narita:成田:narita@example.com:,furuya:古屋:furuya@example.com:,ando:安藤:ando@example.com:

# Optional pre-registered monthly members: display_name:line_user_id,...
MEMBER_LIST=

# LINE user IDs allowed to issue ticket administration commands.
ADMIN_USER_IDS=

# LINE group ID that receives customer ticket-purchase/billing notifications.
ADMIN_NOTIFICATION_GROUP_ID=

BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=18
MAX_DAYS_AHEAD=30
TICKET_MAX_DAYS_AHEAD=90
TIMEZONE=Asia/Tokyo

BOOKING_DURATION_MINUTES=60
# BOOKING_INTERVAL_MINUTES=30
FULL_DAY_BLOCK_KEYWORD=NG
MEMBER_NEXT_MONTH_OPEN_DAY=25

PORT=8080

# Optional locally; Cloud Run automatically uses its current project.
FIRESTORE_PROJECT_ID=
